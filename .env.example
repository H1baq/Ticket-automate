# ---------------------------------------------------------------------------
# HDTMS environment configuration.
# Copy this file to .env, then run `php artisan key:generate`.
# Never commit .env or put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Product name shown in titles and emails.
APP_NAME="HDTMS"
# local | testing | production
APP_ENV=local
# Generated by `php artisan key:generate`. Leave empty here.
APP_KEY=
# true only in local development. Must be false in production.
APP_DEBUG=true
# Public URL of the application, used in emails and generated links.
APP_URL=http://localhost:8000
# Timezone used for display, scheduling and due times.
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Backing store for `php artisan down`.
APP_MAINTENANCE_DRIVER=file
# Cost factor for password hashing (bcrypt).
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
# stack | single | daily | stderr
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | notice | warning | error | critical
LOG_LEVEL=debug

# --- Database (MySQL 8 / MariaDB) ------------------------------------------
# Create the databases `hdtms` and `hdtms_test` before running migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hdtms
DB_USERNAME=root
DB_PASSWORD=

# --- Session ---------------------------------------------------------------
SESSION_DRIVER=database
# Idle timeout in minutes (30 per the security requirements).
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS (always in production).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache, queue and filesystem -------------------------------------------
CACHE_STORE=database
# Run the worker with `php artisan queue:work`.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail ------------------------------------------------------------------
# log writes emails to storage/logs. Use smtp with Mailpit locally
# (127.0.0.1:1025) or your SMTP provider in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (Vite) -------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

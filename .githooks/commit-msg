#!/usr/bin/env bash
# Commit-msg: forbid AI attribution and enforce Conventional Commits.
set -euo pipefail

message_file="$1"
subject="$(sed -n '1p' "$message_file")"

if grep -qiE '^co-authored-by:' "$message_file"; then
    echo "commit-msg: 'Co-Authored-By:' lines are not allowed." >&2
    exit 1
fi

if grep -qi 'Generated with Claude' "$message_file"; then
    echo "commit-msg: AI attribution text is not allowed." >&2
    exit 1
fi

# Merge and revert commits generated by git are allowed as they are.
if [[ "$subject" == Merge* || "$subject" == Revert* ]]; then
    exit 0
fi

if [ "${#subject}" -gt 72 ]; then
    echo "commit-msg: the subject is ${#subject} characters; the limit is 72." >&2
    exit 1
fi

pattern='^(feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! [[ "$subject" =~ $pattern ]]; then
    cat >&2 <<MSG
commit-msg: the subject does not follow Conventional Commits.

  type(scope): imperative summary, at most 72 characters in total

Types: feat, fix, refactor, perf, test, docs, style, build, ci, chore, revert.
Got: $subject
MSG
    exit 1
fi
